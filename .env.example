# Local development (docker-compose.dev.yml)
DATABASE_URL=postgresql://spaceapps:spaceapps_local@localhost:5432/spaceapps

# On the desktop server the API joins the `spaceapps-net` Docker network and uses
# host `spaceapps-postgres`; its credentials are injected there, never committed.
# DATABASE_URL=postgresql://spaceapps:<server-password>@spaceapps-postgres:5432/spaceapps
