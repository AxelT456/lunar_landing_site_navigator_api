      "id": "validacion-falla",
      "from": "fastapi",
      "to": "cliente",
      "y": 200,
      "label": "400 / 422 error de validación (ERR_*)",
      "variant": "security",
      "note": "ERR_INVALID_PAYLOAD: JSON inválido o campo faltante (400) · ERR_INVALID_COORDINATES: lat/lon (422) · ERR_DATE_OUT_OF_RANGE: año fuera de 1900–2050 (422)"
    },
    {
      "id": "request-valido",
      "from": "fastapi",
      "to": "router",
      "y": 317,
      "label": "EvaluateRequest válido",
      "note": "lon normalizada a [0, 360); start_utc a ISO-8601 Z"
    },
